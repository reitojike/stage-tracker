{
  "name": "stage-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "format:check": "prettier --config .ai-dev-foundation/quality/prettier.config.mjs --ignore-path .gitignore --ignore-path supabase/.gitignore --ignore-path .prettierignore --check . && pnpm --filter @stage-tracker/web run format:check",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck && pnpm run typecheck:rls",
    "typecheck:rls": "tsc --noEmit -p test/rls/tsconfig.json",
    "test:unit": "turbo run test:unit",
    "build": "turbo run build",
    "build-storybook": "turbo run build-storybook",
    "foundation:sync": "node scripts/run-foundation-tool.mjs sync",
    "foundation:check": "node scripts/run-foundation-tool.mjs check && node scripts/check-quality-profile-drift.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "dev": "pnpm --filter @stage-tracker/web run dev",
    "supabase:types": "node scripts/generate-supabase-types.mjs",
    "supabase:types:check": "node scripts/check-supabase-types-drift.mjs",
    "supabase:migrations:check": "node .ai-dev-foundation/quality/check-migration-version-collision.mjs",
    "supabase:migrations:ordering-fence": "node scripts/check-migration-ordering-fence.mjs",
    "supabase:migrations:drift": "node scripts/check-migration-drift.mjs",
    "agent-rules:check": "cd apps/web && node ../../.ai-dev-foundation/quality/check-agent-rules-disabled.mjs",
    "legacy:check": "node scripts/check-legacy-removal.mjs",
    "test:rls": "node scripts/run-rls-suite.mjs",
    "test:rls:guardrail-proof": "node --experimental-strip-types test/rls/guardrail-proof.mjs",
    "test:db": "supabase test db --local",
    "test:auth:unit": "pnpm --filter @stage-tracker/web exec vitest run src/lib/auth src/app/sign-in src/lib/actions/passkeys.test.ts src/lib/pwa/app-identity.test.ts",
    "client-role-privileges:check": "node .ai-dev-foundation/quality/check-client-role-table-privileges.mjs",
    "auth:provision-user": "node scripts/provision-user.mjs",
    "catalog:grant-creator": "node scripts/grant-catalog-creator.mjs",
    "catalog:import": "node scripts/import-catalog-events.mjs",
    "tickets:import": "node scripts/import-ticket-opportunities.mjs",
    "holidays:update": "node scripts/update-japanese-holidays.mjs",
    "verify:code": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test:unit && pnpm run test:scripts && pnpm run foundation:check && pnpm run agent-rules:check && pnpm run legacy:check && pnpm run supabase:migrations:check",
    "verify:build": "pnpm run build && pnpm run build-storybook",
    "verify:database:start": "supabase start --exclude realtime,storage-api,imgproxy,studio,edge-runtime,logflare,vector,supavisor",
    "verify:database:db-checks": "pnpm run supabase:types:check && pnpm run test:rls && pnpm run client-role-privileges:check",
    "verify:database:checks": "pnpm run verify:database:db-checks",
    "verify:database": "pnpm run verify:database:start && supabase db reset && pnpm run verify:database:checks",
    "verify:profile": "pnpm run agent-rules:check && pnpm run supabase:migrations:check && pnpm run verify:database",
    "verify": "pnpm run verify:code && pnpm run verify:build && pnpm run verify:database",
    "e2e:install-browsers": "pnpm --filter @stage-tracker/web exec playwright install --with-deps chromium",
    "test:e2e": "pnpm --filter @stage-tracker/web run test:e2e",
    "verify:e2e": "pnpm run verify:database:start && supabase db reset && pnpm run test:e2e",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "supabase:migrations:artifact-fence": "node scripts/check-artifact-sequencing-fence.mjs",
    "supabase:migrations:apply": "node scripts/apply-pending-migrations.mjs"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.115.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20",
    "@types/pg": "^8.11.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.0.1",
    "pg": "^8.13.0",
    "prettier": "^3.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "supabase": "^2.115.0",
    "turbo": "2.10.12",
    "typescript": "^5",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.0"
  }
}
