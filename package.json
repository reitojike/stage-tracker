{
  "name": "stage-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format:check": "prettier --config .ai-dev-foundation/quality/prettier.config.mjs --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --experimental-strip-types --test src/domain/__tests__/*.test.ts src/infrastructure/supabase/__tests__/*.test.ts src/app/schedule/_components/__tests__/*.test.ts src/app/catalog/_components/__tests__/*.test.ts src/app/calendar/_components/__tests__/*.test.ts",
    "foundation:sync": "node scripts/run-foundation-tool.mjs sync",
    "foundation:check": "node scripts/run-foundation-tool.mjs check && node scripts/check-quality-profile-drift.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "supabase:types": "node scripts/generate-supabase-types.mjs",
    "supabase:types:check": "node scripts/check-supabase-types-drift.mjs",
    "supabase:migrations:check": "node .ai-dev-foundation/quality/check-migration-version-collision.mjs",
    "agent-rules:check": "node .ai-dev-foundation/quality/check-agent-rules-disabled.mjs",
    "test:rls": "node --experimental-strip-types --test test/rls/*.test.ts",
    "test:rls:guardrail-proof": "node --experimental-strip-types test/rls/guardrail-proof.mjs",
    "test:auth": "node --experimental-strip-types --test --test-concurrency=1 test/auth/*.test.ts",
    "auth:provision-user": "node scripts/provision-user.mjs",
    "catalog:grant-creator": "node scripts/grant-catalog-creator.mjs",
    "catalog:import": "node scripts/import-catalog-events.mjs",
    "holidays:update": "node scripts/update-japanese-holidays.mjs",
    "verify:code": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run foundation:check && npm run agent-rules:check && npm run supabase:migrations:check",
    "verify:build": "npm run build && npm run build-storybook",
    "verify:database": "supabase start && supabase db reset && npm run supabase:types:check && npm run test:rls && npm run test:auth",
    "verify": "npm run verify:code && npm run verify:build && npm run verify:database",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.58.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.11.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "pg": "^8.13.0",
    "prettier": "^3.0.0",
    "supabase": "^2.115.0",
    "typescript": "^5",
    "typescript-eslint": "^8.0.0",
    "storybook": "^9.1.20",
    "@storybook/nextjs-vite": "^9.1.20",
    "@storybook/addon-a11y": "^9.1.20",
    "@storybook/addon-docs": "^9.1.20",
    "eslint-plugin-storybook": "^9.1.20",
    "vite": "^6.4.0"
  }
}
