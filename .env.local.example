# Copy to .env.local (gitignored) and fill in from `supabase status -o json`
# while local Supabase is running (`npm run db:start`).
#
# Only the public (anon) values belong here. Admin provisioning
# (scripts/provision-user.mjs) reads the service-role key straight from
# `supabase status`, so there is no reason to keep a server secret in a
# local env file.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
