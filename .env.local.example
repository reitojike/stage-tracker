# Copy to .env.local (gitignored) and fill in from `supabase status -o json`
# while local Supabase is running (`npm run db:start`).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never exposed to the browser (no NEXT_PUBLIC_ prefix). Used
# only by local admin-provisioning scripts (see scripts/provision-user.mjs),
# never by application request handling.
SUPABASE_SERVICE_ROLE_KEY=
