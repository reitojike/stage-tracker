{
  "name": "@stage-tracker/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build",
    "test-storybook": "cross-env TEMP=storybook-static test-storybook --url http://127.0.0.1:6007 --index-json --ci --verbose --disable-telemetry",
    "test-storybook:ci": "concurrently -k -s first -n STORYBOOK,TEST -c magenta,blue \"http-server storybook-static --port 6007 --silent\" \"wait-on http://127.0.0.1:6007/index.json && pnpm run test-storybook\""
  },
  "dependencies": {
    "@stage-tracker/domain": "workspace:*",
    "@stage-tracker/ui": "workspace:*",
    "@supabase/ssr": "^0.12.6",
    "@supabase/supabase-js": "^2.115.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "cn": "^0.2.5",
    "next": "16.3.4",
    "next-safe-action": "^8.7.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "^9.1.20",
    "@storybook/addon-docs": "^9.1.20",
    "@storybook/nextjs-vite": "^9.1.20",
    "@storybook/test-runner": "0.24.5",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "10.0.5",
    "cross-env": "10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "^9.1.20",
    "http-server": "14.1.1",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "prettier": "^3.9.6",
    "shadcn": "^4.21.0",
    "storybook": "^9.1.20",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.3.6",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.0",
    "wait-on": "9.1.0"
  },
  "packageManager": "pnpm@12.3.4"
}
