# apps/web が必要とする環境変数（src/env.ts が型付き検証する）。
# 実際の値は .env.local に置くこと（.gitignore 対象）。
#
# Supabase 接続情報。通常の app runtime が使う client は anon key のみ。
# anon key はブラウザへ露出する前提の鍵であり、この2つを NEXT_PUBLIC_
# prefix で公開しても secret 漏洩にはならない。

# Supabase project の URL（ローカル開発では `supabase start` の出力を使う）。
NEXT_PUBLIC_SUPABASE_URL=

# Supabase project の anon key。
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# official ingestion Workflow 専用。Vercel Production の Sensitive Environment
# Variable としてだけ設定し、Preview / CI / local の通常起動には設定しない。
# NEXT_PUBLIC_ prefix は禁止。値や実値に近い placeholder を commit しない。
# STAGE_TRACKER_INGESTION_SUPABASE_SECRET_KEY=

# official ingestion の曖昧な entity alignment 専用。未設定時は deterministic
# matching のみを使い、曖昧な候補を identity review block へ fail-closed する。
# Vercel Production の Sensitive Environment Variable としてだけ設定する。
# JEV_API_KEY=

# 宝塚友の会 schedule PDF の bounded Firecrawl v2 /parse canary 専用。
# raw PDF/provider response は staging へ保存せず、schema-shaped facts だけを使う。
# 未設定時は PDF source run を provider_unavailable として fail-closed する。
# FIRECRAWL_API_KEY=

# env 未設定でも `pnpm run build` を通したい場合（CI 等）に "1" を設定する。
# SKIP_ENV_VALIDATION=1
